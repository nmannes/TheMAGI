# Copy to docker.env and fill in. docker.env is gitignored.
# Only put secrets and container-specific settings here; paths inside the
# container are fixed by the image and compose file.

MAGI_TARGET=POOK#392

# Required for Telegram delivery. Leave both blank and set
# HIT_REVIEW_TELEGRAM=0 to render without sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

HIT_REVIEW_LIMIT=5
HIT_REVIEW_RESOLUTION=720p
HIT_REVIEW_MAX_OUT_SIZE=1GB
HIT_REVIEW_TELEGRAM=1
# HIT_REVIEW_DRY_RUN=1
# HIT_REVIEW_DEATHS_ONLY=1
